  personaje: {fileID: 0}
  lineas:
  - nombre: Blair
    texto: "As\xED que est\xE1 soy yo."
  - nombre: Blair
    texto: "Al menos de lo que puedo recordar, \xBFMi cabello es azul y mi piel tan
      p\xE1lida?"
  - nombre: Blair
    texto: Me veo del asco.
  - nombre: Blair
    texto: 'Creo... Creo... Que algo me sobresale de una ojera. '
  - nombre: Blair
    texto: "Deber\xEDa irme. "
  alIniciarLaEscena: 1
  esperaAntesDeMostrar: 0
  soloUnaVez: 1
