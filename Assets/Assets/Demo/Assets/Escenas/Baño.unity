  m_Script: {fileID: 11500000, guid: 7ee31bdaf3aa4654aa471289ad5b38a9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogoTrigger
  personaje: {fileID: 0}
  lineas:
  - nombre: Blair
    texto: ...
  - nombre: Blair
    texto: "Creo que es un alivio que no pueda recordar exactamente que ocurr\xEDo
      ese d\xEDa."
  - nombre: Blair
    texto: "Tengo el presentimiento de que ocurri\xF3 algo terrible hace 15 a\xF1os...
      Y de que de alguna forma soy responsable de todo lo que ocurr\xEDo despu\xE9s
      de eso. "
  - nombre: Blair
    texto: "Pude evitarlo. Pude haber dicho cualquier cosa... \xA1Hacer cualquier
      se\xF1a! o.. o... simplemente haberles advertido. "
  - nombre: Blair
    texto: 'Merezco este castigo, y ellos merecen la verdad. '
  alIniciarLaEscena: 0
  esperaAntesDeMostrar: 0
